exports[`JSON-schema exports > execution-plan-v1 export is stable 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "minLength": 1,
            "type": "string",
          },
          "lotId": {
            "minLength": 1,
            "type": "string",
          },
          "quantity": {
            "exclusiveMinimum": 0,
            "type": "number",
          },
          "reason": {
            "minLength": 1,
            "type": "string",
          },
          "symbol": {
            "minLength": 1,
            "type": "string",
          },
          "type": {
            "enum": [
              "sell",
              "buy",
              "hold",
            ],
            "type": "string",
          },
        },
        "required": [
          "type",
          "accountId",
          "symbol",
          "quantity",
          "reason",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
    "estimatedTaxSavings": {
      "minimum": 0,
      "type": "number",
    },
    "washSaleWarnings": {
      "items": {
        "type": "string",
      },
      "type": "array",
    },
  },
  "required": [
    "actions",
    "estimatedTaxSavings",
    "washSaleWarnings",
  ],
  "type": "object",
}
`;

