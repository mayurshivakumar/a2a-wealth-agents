exports[`JSON-schema exports > portfolio-v1 export is stable 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asOf": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string",
    },
    "holdings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "minLength": 1,
            "type": "string",
          },
          "accountType": {
            "enum": [
              "taxable",
              "traditional-ira",
              "roth-ira",
              "401k",
            ],
            "type": "string",
          },
          "currentPrice": {
            "exclusiveMinimum": 0,
            "type": "number",
          },
          "lots": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "costBasis": {
                  "exclusiveMinimum": 0,
                  "type": "number",
                },
                "lotId": {
                  "minLength": 1,
                  "type": "string",
                },
                "purchaseDate": {
                  "anyOf": [
                    {
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "quantity": {
                  "exclusiveMinimum": 0,
                  "type": "number",
                },
              },
              "required": [
                "lotId",
                "quantity",
                "costBasis",
                "purchaseDate",
              ],
              "type": "object",
            },
            "minItems": 1,
            "type": "array",
          },
          "priceAsOf": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
            "type": "string",
          },
          "symbol": {
            "pattern": "^[A-Z][A-Z0-9.]{0,5}$",
            "type": "string",
          },
        },
        "required": [
          "accountId",
          "accountType",
          "symbol",
          "lots",
          "currentPrice",
          "priceAsOf",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
    "portfolioId": {
      "minLength": 1,
      "type": "string",
    },
    "uninvestedCash": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "minLength": 1,
            "type": "string",
          },
          "amount": {
            "minimum": 0,
            "type": "number",
          },
        },
        "required": [
          "accountId",
          "amount",
        ],
        "type": "object",
      },
      "type": "array",
    },
  },
  "required": [
    "portfolioId",
    "asOf",
    "holdings",
    "uninvestedCash",
  ],
  "type": "object",
}
`;

