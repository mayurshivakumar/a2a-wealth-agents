exports[`JSON-schema exports > strategy-request-v1 export is stable 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "constraints": {
      "additionalProperties": false,
      "properties": {
        "excludeSectors": {
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
        "maxExpenseRatioPct": {
          "exclusiveMinimum": 0,
          "type": "number",
        },
        "preferredDomiciles": {
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "type": "array",
        },
      },
      "type": "object",
    },
    "customWeights": {
      "additionalProperties": {
        "maximum": 100,
        "minimum": 0,
        "type": "number",
      },
      "propertyNames": {
        "enum": [
          "us-total-market",
          "intl-developed",
          "us-bonds",
          "esg-thematic",
          "gold",
          "commodities",
        ],
        "type": "string",
      },
      "type": "object",
    },
    "philosophy": {
      "enum": [
        "bogleheads-three-fund",
        "esg-tilt",
        "dividend-growth",
        "all-weather",
        "custom",
      ],
      "type": "string",
    },
  },
  "required": [
    "philosophy",
  ],
  "type": "object",
}
`;

