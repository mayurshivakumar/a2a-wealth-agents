exports[`JSON-schema exports > allocation-v1 export is stable 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "philosophy": {
      "minLength": 1,
      "type": "string",
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assetClass": {
            "enum": [
              "us-total-market",
              "intl-developed",
              "us-bonds",
              "esg-thematic",
              "gold",
              "commodities",
            ],
            "type": "string",
          },
          "preferredVehicles": {
            "items": {
              "minLength": 1,
              "type": "string",
            },
            "minItems": 1,
            "type": "array",
          },
          "weightPct": {
            "maximum": 100,
            "minimum": 0,
            "type": "number",
          },
        },
        "required": [
          "assetClass",
          "weightPct",
          "preferredVehicles",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
  },
  "required": [
    "philosophy",
    "targets",
  ],
  "type": "object",
}
`;

