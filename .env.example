# LLM (optional — omit for --scripted mode; never required by demos/tests)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Topology
A2A_HOST=localhost
ORCHESTRATOR_PORT=3000
PORTFOLIO_PORT=4001
STRATEGY_PORT=4002
TAX_PORT=4003
PORTFOLIO_AGENT_URL=http://localhost:4001
STRATEGY_AGENT_URL=http://localhost:4002
TAX_AGENT_URL=http://localhost:4003

# Protocol / client behavior (defaults from design/implementationPlan.md §2 config table)
A2A_REQUEST_TIMEOUT_MS=30000
GETTASK_POLL_MS=2000
INPUT_REQUIRED_REMINDER_MS=60000
SSE_RECONNECT_ATTEMPTS=3
SSE_RECONNECT_BASE_MS=1000
TAX_SIMULATED_DELAY_MS=1500

# Logging
LOG_LEVEL=info
# LOG_FORMAT=pretty

# Telemetry (optional; everything is a no-op when unset)
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
